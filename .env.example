PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
# Sessions are opaque server-side ids; no signing secret is needed.
# Set to true when serving over HTTPS (needed for a proper installable PWA).
COOKIE_SECURE=false
# Optional: OAuth logins. Leave unset to keep password-only auth.
# Google (https://console.cloud.google.com/apis/credentials, authorized
# redirect URI: <your-origin>/api/auth/oauth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple (Services ID + Key; private key with literal \n or real newlines)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Optional: override the OAuth callback base (defaults to the request origin).
OAUTH_REDIRECT_BASE=
