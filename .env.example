PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
# Sessions are opaque server-side ids; no signing secret is needed.
# Set to true when serving over HTTPS (needed for a proper installable PWA).
COOKIE_SECURE=false
# Optional: OAuth logins. Leave unset to keep password-only auth.
# Google (https://console.cloud.google.com/apis/credentials, authorized
# redirect URI: <your-origin>/api/auth/oauth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple (Services ID + Key; private key with literal \n or real newlines)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Optional: override the OAuth callback base (defaults to the request origin).
OAUTH_REDIRECT_BASE=
# Optional: shared passwords via Proton Pass CLI (pass-cli).
# Set a personal access token with access to the shared vault; the server
# shells out to `pass-cli item list/view --vault-name <vault> --output json`.
# Leave unset to hide the Passwords section (API returns 503).
PROTON_PASS_PERSONAL_ACCESS_TOKEN=
PROTON_PASS_VAULT=Shared
# Optional: pass-cli binary path (defaults to `pass-cli` on PATH).
PASS_CLI_BIN=pass-cli
# Optional: hybrid cache. The vault-sync sidecar (vault-sync/) pushes a vault
# cache into Basket so Workers/Vercel can serve passwords without pass-cli.
# Set the same random secret here and for the sidecar; empty disables sync.
VAULT_SYNC_SECRET=
VAULT_SYNC_INTERVAL_S=300
# Required for the cache: key that encrypts credential payloads at rest
# (AES-GCM; any string works, it is hashed to 256 bits). Without it the
# cache cannot be written or opened. Backups stay opaque without this key.
VAULT_CACHE_KEY=
# Optional: restrict the Passwords section to one household (its id).
# Unset means any signed-in user on this instance can read the cache —
# set it on any multi-household instance.
VAULT_HOUSEHOLD_ID=
# Optional: server-sent email (share-via-email, test messages). Node-only:
# Cloudflare Workers and Vercel cannot open SMTP sockets, so the endpoints
# return 503 there. Mail is only ever sent to the user's own account email.
# Example (port 587 STARTTLS; use 465 + SMTP_SECURE=true for implicit TLS):
#SMTP_HOST=mail.example.com
#SMTP_PORT=587
#SMTP_USER=basket@example.com
#SMTP_PASS=secret
#SMTP_FROM=basket@example.com
#SMTP_SECURE=false
